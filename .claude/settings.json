{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python.exe -m ruff *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Edit(./training/splits.json)",
      "Bash(*RADARSENSE_ALLOW_TEST*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
